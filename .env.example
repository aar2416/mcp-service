# --- Zendesk credentials -------------------------------------------------
# Your subdomain: https://<ZENDESK_SUBDOMAIN>.zendesk.com
ZENDESK_SUBDOMAIN=yourcompany

# Option 1: API token auth (Admin Center > Apps and integrations > APIs > Zendesk API)
ZENDESK_EMAIL=agent@yourcompany.com
ZENDESK_API_TOKEN=your_api_token

# Option 2: OAuth access token (takes precedence over API token if set)
# ZENDESK_OAUTH_TOKEN=

# --- Behaviour -----------------------------------------------------------
# When true, every non-GET call is refused (safe exploration mode)
ZENDESK_READ_ONLY=false
# Limit which tool groups are exposed (fewer tools = less LLM context). Default: all.
# Options: tickets,search,users,organizations,groups,admin,help_center,generic
# ZENDESK_TOOLSETS=tickets,search,users,organizations
ZENDESK_TIMEOUT=30
ZENDESK_MAX_RETRIES=3

# --- MCP transport -------------------------------------------------------
# stdio (default, for Claude Desktop / Claude Code) | streamable-http | sse
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
